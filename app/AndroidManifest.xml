<?xml version="1.0" encoding="utf-8"?>
<!-- 占位符：io.github.taobaoadclean = 模块包名（如 io.github.xxxclean）；淘系去广告 = 设置页显示名 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.taobaoadclean"
    android:versionCode="2"
    android:versionName="0.1.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <application
        android:name=".App"
        android:label="淘系去广告"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LSPosed 框架服务通道（设置页与框架通信）；authorities 固定为 <模块包名>.XposedService -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="io.github.taobaoadclean.XposedService"
            android:exported="true" />

        <!-- 目标进程 → 设置页 的状态查询通道（只读） -->
        <provider
            android:name=".StatusProvider"
            android:authorities="io.github.taobaoadclean.status"
            android:exported="true" />

        <!-- 目标进程 → 设置页 的一次性状态上报 -->
        <receiver android:name=".StatusReceiver" android:exported="true">
            <intent-filter><action android:name="io.github.taobaoadclean.REPORT" /></intent-filter>
        </receiver>
    </application>
</manifest>
